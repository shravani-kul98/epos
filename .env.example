# EPOS settings. Copy this file to .env and uncomment only what you need; every value below is a
# placeholder. Nothing is required for a local run: EPOS then uses SQLite in data/epos_next.db,
# no AI service and a signing key generated at startup.

# Azure OpenAI for Ask EPOS and the AI explanations. ENDPOINT is the full chat-completions URL of a
# deployment that supports structured JSON output.
# API_KEY=replace-with-your-azure-openai-key
# ENDPOINT=https://your-resource.openai.azure.com/openai/deployments/your-deployment/chat/completions?api-version=your-api-version

# Signs session tokens so sign-ins survive a restart. JWT_SECRET is accepted as an alternative name.
# EPOS_SECRET_KEY=replace-with-a-long-random-string

# Database as a SQLAlchemy URL. DATABASE_URL is accepted as an alternative name.
# PostgreSQL additionally needs: pip install "psycopg[binary]>=3.2"
# EPOS_DATABASE_URL=

# development (default) or production. Production also requires PostgreSQL and a signing key of at
# least 32 characters, and turns off the API documentation and automatic startup migrations.
# ENVIRONMENT=development

# How Ask EPOS reads a question: classic (rule-based router, the local default) or agent (the model
# plans each lookup; needs API_KEY and ENDPOINT).
# EPOS_ASSISTANT_MODE=classic

# Sign-up rules.
# EPOS_SELF_REGISTRATION=true
# EPOS_REGISTRATION_EMAIL_DOMAINS=example.com
# EPOS_REGISTRATION_REQUIRES_INVITATION=false

# Other switches, shown with their local defaults.
# EPOS_ENABLE_API_DOCS=true
# EPOS_RUN_MIGRATIONS_ON_STARTUP=true
# EPOS_SCHEMA_AUTO_UPGRADE=true
# EPOS_RATE_LIMITS=true
# EPOS_RATE_LIMIT_STORE=memory
# EPOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
